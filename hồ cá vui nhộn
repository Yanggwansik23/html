<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>hồ cá vui nhộn_ GiaPo 5201104083</title>
<style>
  :root{ --sand:#d9c08a; }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;background:#021a2b;overflow:hidden;font-family:system-ui,sans-serif}
  #tank{
    position:relative;width:100vw;height:100vh;overflow:hidden;cursor:pointer;
    background:linear-gradient(to bottom,#4fc3e8 0%,#1f86b8 30%,#0e5a8a 65%,#063252 100%);
  }
  /* tia nắng */
  .rays{position:absolute;inset:-20% -10% 30% -10%;pointer-events:none;mix-blend-mode:screen;opacity:.35;
    background:
      repeating-linear-gradient(105deg,transparent 0 90px,rgba(255,255,255,.35) 110px,transparent 150px 260px);
    -webkit-mask-image:linear-gradient(to bottom,#000,transparent 85%);mask-image:linear-gradient(to bottom,#000,transparent 85%);
    animation:rays 14s ease-in-out infinite alternate;}
  @keyframes rays{from{transform:translateX(-40px) skewX(-4deg)}to{transform:translateX(40px) skewX(4deg)}}
  /* mặt nước */
  .surface{position:absolute;top:0;left:0;right:0;height:40px;pointer-events:none;
    background:linear-gradient(to bottom,rgba(255,255,255,.55),transparent);
    animation:shimmer 4s ease-in-out infinite alternate}
  @keyframes shimmer{from{opacity:.5}to{opacity:1}}
  /* cát */
  .sand{position:absolute;left:0;right:0;bottom:0;height:14vh;pointer-events:none;z-index:5;
    background:
      radial-gradient(ellipse 60% 100% at 20% 100%,#e6cf9b,transparent 70%),
      radial-gradient(ellipse 50% 100% at 75% 100%,#cbb07a,transparent 70%),
      linear-gradient(to bottom,transparent,#b99a62 60%,#9c7f4c);
    border-radius:50% 50% 0 0/30% 30% 0 0;}
  .rock{position:absolute;bottom:2vh;background:radial-gradient(circle at 30% 30%,#8a8f94,#4a4f55);border-radius:50% 50% 45% 45%;z-index:6;pointer-events:none}
  /* rong */
  .weed{position:absolute;bottom:6vh;width:40px;transform-origin:50% 100%;z-index:4;pointer-events:none;
    animation:sway 5s ease-in-out infinite alternate}
  @keyframes sway{from{transform:rotate(-5deg)}to{transform:rotate(5deg)}}
  /* sinh vật */
  .creature{position:absolute;left:0;top:0;will-change:transform;user-select:none;-webkit-user-drag:none;pointer-events:none}
  .creature.far{filter:blur(1.2px) brightness(.8) saturate(.8)}
  /* bong bóng */
  .bubble{position:absolute;border-radius:50%;pointer-events:none;z-index:7;
    background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.9),rgba(255,255,255,.15) 60%,rgba(255,255,255,.35));
    border:1px solid rgba(255,255,255,.5)}
  /* thức ăn */
  .food{position:absolute;width:6px;height:6px;border-radius:50%;background:#e8a85a;pointer-events:none;z-index:7}
  .hud{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:20;color:#fff;
    background:rgba(0,30,50,.4);backdrop-filter:blur(6px);padding:8px 16px;border-radius:999px;font-size:14px;
    pointer-events:none;transition:opacity 1s}
</style>
</head>
<body>
<div id="tank">
  <div class="rays"></div>
  <div class="surface"></div>
  <div class="hud" id="hud">Bấm vào hồ để thả thức ăn và bong bóng 🫧</div>
  <div class="sand"></div>
</div>

<script>
(() => {
  const tank = document.getElementById('tank');
  const rand = (a, b) => a + Math.random() * (b - a);
  let W = innerWidth, H = innerHeight;
  addEventListener('resize', () => { W = innerWidth; H = innerHeight; });

  /* ---------- Trang trí đáy hồ ---------- */
  function seaweed(x, h, color){
    const d = document.createElement('div');
    d.className = 'weed';
    d.style.left = x + '%';
    d.style.animationDuration = rand(3.5, 6.5) + 's';
    d.style.animationDelay = rand(-5, 0) + 's';
    d.innerHTML = `<svg viewBox="0 0 40 200" width="40" height="${h}" preserveAspectRatio="none">
      <path d="M20 200 C5 160 35 130 20 90 C8 60 30 30 20 0 C34 30 14 60 28 90 C40 130 12 160 28 200Z" fill="${color}"/></svg>`;
    tank.appendChild(d);
  }
  [[4,180,'#2f9e5b'],[8,130,'#38b26a'],[13,200,'#1f8048'],[27,120,'#38b26a'],
   [44,150,'#2f9e5b'],[58,110,'#1f8048'],[70,190,'#38b26a'],[78,140,'#2f9e5b'],
   [90,210,'#1f8048'],[95,150,'#38b26a']].forEach(a => seaweed(...a));
  [[6,120,50],[60,160,70],[85,100,45]].forEach(([x,w,h]) => {
    const r = document.createElement('div');
    r.className = 'rock'; r.style.cssText += `left:${x}%;width:${w}px;height:${h}px`;
    tank.appendChild(r);
  });

  /* ---------- Sinh vật (dùng các ảnh trong thư mục) ---------- */
  // speed: px/giây | scale: kích thước | y: vùng độ sâu (0 = mặt nước, 1 = đáy)
  const species = [
    { src:'data:image/png;base64,',          n:1, speed:[110,150], scale:[1.0,1.0],  y:[.25,.55], bob:14, z:3 },
    { src:'data:image/png;base64,',         n:1, speed:[40,55],   scale:[1.1,1.1],  y:[.45,.7],  bob:20, z:3 },
    { src:'data:image/png;base64,', n:2, speed:[70,100],  scale:[0.9,1.3],  y:[.2,.7],   bob:25, z:2, school:true },
    { src:'data:image/png;base64,',    n:2, speed:[50,80],   scale:[0.8,1.2],  y:[.15,.65], bob:30, z:1, far:true, school:true },
    { src:'data:image/png;base64,', diver:true,         n:1, speed:[55,75],   scale:[0.9,0.9],  y:[.3,.6],   bob:10, z:3 },
    { src:'data:image/png;base64,', diver:true,         n:1, speed:[55,75],   scale:[0.9,0.9],  y:[.3,.6],   bob:10, z:3 },
    { src:'data:image/png;base64,', diver:true,         n:1, speed:[55,75],   scale:[0.9,0.9],  y:[.3,.6],   bob:10, z:3 },
  ];

  const creatures = [];
  species.forEach(sp => {
    for (let i = 0; i < sp.n; i++){
      const img = new Image();
      img.src = sp.src; img.draggable = false;
      img.className = 'creature' + (sp.far ? ' far' : '');
      img.style.zIndex = sp.z;
      tank.appendChild(img);
      const c = {
        el: img, sp,
        dir: Math.random() < .5 ? 1 : -1,
        speed: rand(...sp.speed),
        scale: rand(...sp.scale),
        x: rand(0, W), baseY: rand(...sp.y) * H,
        phase: rand(0, 6.28), bobSpd: rand(.6,1.4),
        w: 0, h: 0, tilt: 0,
      };
      img.onload = () => { c.w = img.naturalWidth * c.scale; c.h = img.naturalHeight * c.scale; };
      creatures.push(c);
      // thợ lặn thở ra bong bóng
      if (sp.diver) c.bubbler = true;
    }
  });

  /* ---------- Bong bóng ---------- */
  function bubble(x, y, size){
    const b = document.createElement('div');
    b.className = 'bubble';
    size = size || rand(4, 14);
    b.style.width = b.style.height = size + 'px';
    tank.appendChild(b);
    const sp = rand(40, 90), wob = rand(8, 24), ph = rand(0, 6.28), x0 = x;
    let yy = y, t = 0, last = performance.now();
    (function tick(now){
      const dt = (now - last) / 1000; last = now; t += dt;
      yy -= sp * dt;
      b.style.transform = `translate(${x0 + Math.sin(t*2+ph)*wob}px,${yy}px)`;
      if (yy < 20){ b.remove(); return; }
      requestAnimationFrame(tick);
    })(last);
  }
  // bong bóng nền từ đáy hồ
  setInterval(() => bubble(rand(0, W), H - 40), 450);

  /* ---------- Thức ăn ---------- */
  const foods = [];
  function dropFood(x, y){
    for (let i = 0; i < 8; i++){
      const f = document.createElement('div');
      f.className = 'food';
      tank.appendChild(f);
      foods.push({ el: f, x: x + rand(-20, 20), y: y + rand(-10, 10), vy: rand(25, 45) });
    }
  }

  tank.addEventListener('pointerdown', e => {
    dropFood(e.clientX, e.clientY);
    for (let i = 0; i < 5; i++) setTimeout(() => bubble(e.clientX + rand(-15,15), e.clientY, rand(5,16)), i * 90);
    document.getElementById('hud').style.opacity = 0;
  });

  /* ---------- Vòng lặp hoạt ảnh ---------- */
  let last = performance.now(), time = 0, bubTimer = 0;
  function loop(now){
    const dt = Math.min(.05, (now - last) / 1000); last = now; time += dt; bubTimer += dt;

    // thức ăn rơi
    for (let i = foods.length - 1; i >= 0; i--){
      const f = foods[i];
      f.y += f.vy * dt;
      f.el.style.transform = `translate(${f.x}px,${f.y}px)`;
      if (f.y > H - H*.08){ f.el.remove(); foods.splice(i, 1); }
    }

    creatures.forEach(c => {
      if (!c.w) return;
      c.x += c.dir * c.speed * dt;
      // quay đầu khi ra khỏi màn hình
      if (c.dir > 0 && c.x > W + 40){ c.dir = -1; c.baseY = rand(...c.sp.y) * H; c.speed = rand(...c.sp.speed); }
      if (c.dir < 0 && c.x < -c.w - 40){ c.dir = 1;  c.baseY = rand(...c.sp.y) * H; c.speed = rand(...c.sp.speed); }

      // đàn cá lao tới thức ăn gần nhất
      let targetY = c.baseY;
      if (c.sp.school && foods.length){
        let best = null, bd = 1e9;
        foods.forEach(f => { const d = Math.hypot(f.x - (c.x + c.w/2), f.y - c.baseY); if (d < bd){ bd = d; best = f; } });
        if (best && bd < 500){
          targetY = best.y - c.h/2;
          c.baseY += (targetY - c.baseY) * dt * 1.5;
          c.dir = best.x > c.x + c.w/2 ? 1 : -1;
        }
      }

      const bob = Math.sin(time * c.bobSpd + c.phase) * c.sp.bob;
      const tiltTarget = Math.cos(time * c.bobSpd + c.phase) * 3;
      c.tilt += (tiltTarget - c.tilt) * dt * 3;
      const y = Math.max(30, Math.min(H * .85 - c.h, c.baseY + bob));
      const flip = c.dir < 0 ? -1 : 1;
      // ảnh gốc quay mặt sang phải
      c.el.style.transformOrigin = '0 0';
      c.el.style.transform = flip > 0
        ? `translate(${c.x}px,${y}px) scale(${c.scale}) rotate(${c.tilt}deg)`
        : `translate(${c.x + c.w}px,${y}px) scale(${-c.scale},${c.scale}) rotate(${-c.tilt}deg)`;

      // thợ lặn thở ra bong bóng gần miệng
      if (c.bubbler && Math.random() < dt * 1.2){
        bubble(c.x + (c.dir > 0 ? c.w * .85 : c.w * .15), y + c.h * .3, rand(4, 10));
      }
    });
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
