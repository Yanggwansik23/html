<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CV - Trương Gia Po</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:"Segoe UI",Arial,sans-serif;background:#e9edf2;color:#2b2f36;padding:30px 16px;line-height:1.55}
  .cv{max-width:900px;margin:0 auto;background:#fff;box-shadow:0 8px 30px rgba(0,0,0,.15);
      display:grid;grid-template-columns:40% 60%}           /* bố cục 40% - 60% */
  .left,.right{padding:28px 30px}
  .left{background:#1f3a5f;color:#eef3fa}
  .right{background:#fff}
  .head-left{display:flex;align-items:center;justify-content:center;padding-top:34px;padding-bottom:34px}
  .head-right{border-bottom:3px solid #1f3a5f;display:flex;flex-direction:column;justify-content:center}
  .avatar{width:170px;height:170px;border-radius:50%;border:5px solid #fff;overflow:hidden;background:#cfd8e6;
          display:flex;align-items:center;justify-content:center}
  .avatar img{width:100%;height:100%;object-fit:cover}
  h1{font-size:2rem;letter-spacing:.5px;color:#1f3a5f;text-transform:uppercase}
  .job{font-size:1.15rem;color:#e07a1f;font-weight:600;margin-top:4px}
  h2{font-size:1.05rem;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;padding-bottom:6px}
  .left h2{border-bottom:2px solid rgba(255,255,255,.35);color:#fff}
  .right h2{border-bottom:2px solid #1f3a5f;color:#1f3a5f}
  section{margin-bottom:26px}
  ul{list-style:none}
  .left li{margin-bottom:8px}
  .sym{display:inline-block;width:1.6em;color:#ffb866}          /* ký hiệu đặc biệt */
  .skill{margin-bottom:10px}
  .skill span{font-size:.92rem}
  .bar{height:7px;background:rgba(255,255,255,.2);border-radius:4px;margin-top:3px;overflow:hidden}
  .bar i{display:block;height:100%;background:#ffb866;border-radius:4px}
  .item{margin-bottom:16px}
  .item h3{font-size:1rem;color:#1f3a5f}
  .item .time{font-size:.85rem;color:#e07a1f;font-weight:600}
  .item p,.item li{font-size:.93rem}
  .item ul li:before{content:"\2714\00a0";color:#1f3a5f}        /* ✔ */
  .ref{font-size:.92rem;margin-bottom:10px}
  footer{text-align:center;font-size:.8rem;color:#777;margin-top:14px}
  @media(max-width:700px){.cv{grid-template-columns:1fr}.head-left{padding:28px}}
  @media print{body{background:#fff;padding:0}.cv{box-shadow:none}}
</style>
</head>
<body>
<div class="cv">

